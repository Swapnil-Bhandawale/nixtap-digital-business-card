@model List<nixtap_admin.Models.Api.AppointmentDto>
@{ ViewData["Title"] = "Appointments"; Layout = "_AdminLayout"; }
<h1>Appointments</h1>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Date</th><th>Status</th></tr></thead>
        <tbody>
            @if (Model != null && Model.Any()) {
                @foreach (var item in Model) {
                    <tr><td>@item.visitorName</td><td>@item.visitorEmail</td><td>@item.visitorPhone</td><td>@item.requestedDatetime</td><td><span class="badge bg-info">@item.status</span></td></tr>
                }
            } else {
                <tr><td colspan="5" class="text-center text-muted">No appointments available.</td></tr>
            }
        </tbody>
    </table>
</div>
